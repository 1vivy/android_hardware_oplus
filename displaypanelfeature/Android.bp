        "libbase",
        "libcrypto",
        "libtinyxml2",
    ],
    data: [
        "configs/displaypanelfeature_infiniti.xml",
        "tests/data/*",
    ],
    test_options: { unit_test: true },
    cflags: ["-Wall", "-Werror"],
}

