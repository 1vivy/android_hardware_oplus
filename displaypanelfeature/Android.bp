// The open default IDisplayPanelFeature server. It replaces the ODM
// implementation rather than sitting beside it: exactly one default declaration
// for this interface may exist in a build.
cc_binary {
    name: "vendor.oplus.hardware.displaypanelfeature-service.oplus",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.oplus.hardware.displaypanelfeature-service.oplus.rc"],
    vintf_fragments: ["vendor.oplus.hardware.displaypanelfeature-service.oplus.xml"],
    srcs: [
        "Server.cpp",
        "service.cpp",
    ],
    static_libs: [
        "liboplus_displaypanelfeature_backend",
        "liboplus_displaypanelfeature_client",
        "liboplus_displaypanelfeature_dispatch",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcrypto",
        "libtinyxml2",
        "vendor.oplus.hardware.displaypanelfeature-V1-ndk",
    ],
    cflags: ["-Wall", "-Werror"],
}

cc_test_host {
    name: "displaypanelfeature_dispatch_test",
    srcs: ["tests/DispatcherTest.cpp"],
    static_libs: [
        "liboplus_displaypanelfeature_client",
        "liboplus_displaypanelfeature_dispatch",
    ],
    shared_libs: [
        "libbase",
        "libcrypto",
        "libtinyxml2",
    ],
    // The SHIPPED generated map, so the admission tests are evidence about the
    // registry the device installs rather than about a fixture; the revision
    // fixture is the one deliberate exception, since a schema revision cannot
    // be represented by the current map.
    data: [
        "configs/displaypanelfeature_infiniti.xml",
        "tests/data/registry-revision-b.xml",
    ],
    test_options: { unit_test: true },
    cflags: ["-Wall", "-Werror"],
}

cc_binary {
    name: "adfr-floor-daemon",
    vendor: true,
    init_rc: ["adfr-floor-daemon.rc"],
    srcs: ["floor_daemon.cpp"],
    static_libs: ["liboplus_displaypanelfeature_config"],
    shared_libs: [
        "libbase",
        "libtinyxml2",
    ],
    cflags: ["-Wall", "-Werror"],
}
