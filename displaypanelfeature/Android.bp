cc_library_static {
    name: "liboplus_displaypanelfeature_config",
    vendor_available: true,
    host_supported: true,
    srcs: [
        "AdfrConfig.cpp",
        "AdfrFloorPolicy.cpp",
    ],
    export_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "libtinyxml2",
    ],
    cflags: ["-Wall", "-Werror"],
}

cc_library_static {
    name: "liboplus_displaypanelfeature_client",
    vendor_available: true,
    host_supported: true,
    srcs: [
        "DisplayPanelFeatureClient.cpp",
        "FeatureRegistry.cpp",
        "Publisher.cpp",
    ],
    export_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "libcrypto",
        "libtinyxml2",
    ],
    cflags: ["-Wall", "-Werror"],
}

cc_library_static {
    name: "liboplus_displaypanelfeature_aidl_transport",
    vendor_available: true,
    srcs: ["AidlPanelFeatureTransport.cpp"],
    export_include_dirs: ["."],
    static_libs: ["liboplus_displaypanelfeature_client"],
    shared_libs: [
        "libbinder_ndk",
        "vendor.oplus.hardware.displaypanelfeature-V1-ndk",
    ],
    cflags: ["-Wall", "-Werror"],
}

cc_binary {
    name: "displaypanelfeature-publisher",
    vendor: true,
    init_rc: ["displaypanelfeature-publisher.rc"],
    srcs: ["main.cpp"],
    static_libs: [
        "liboplus_displaypanelfeature_aidl_transport",
        "liboplus_displaypanelfeature_client",
        "liboplus_displaypanelfeature_config",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcrypto",
        "libtinyxml2",
        "vendor.oplus.hardware.displaypanelfeature-V1-ndk",
    ],
    cflags: ["-Wall", "-Werror"],
}

cc_test_host {
    name: "displaypanelfeature_config_test",
    srcs: ["tests/AdfrConfigTest.cpp"],
    static_libs: ["liboplus_displaypanelfeature_config"],
    shared_libs: [
        "libbase",
        "libtinyxml2",
    ],
    data: ["tests/data/*"],
    test_options: { unit_test: true },
    cflags: ["-Wall", "-Werror"],
}

cc_test_host {
    name: "displaypanelfeature_registry_test",
    srcs: ["tests/FeatureRegistryTest.cpp"],
    static_libs: ["liboplus_displaypanelfeature_client"],
    shared_libs: [
        "libbase",
        "libcrypto",
        "libtinyxml2",
    ],
    data: [
        "configs/displaypanelfeature_infiniti.xml",
        "tests/data/*",
    ],
    test_options: { unit_test: true },
    cflags: ["-Wall", "-Werror"],
}

