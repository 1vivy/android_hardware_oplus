android_app {
    name: "OplusLtpo",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "SettingsLib",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

java_binary_host {
    name: "OplusLtpoConfigTests",
    srcs: [
        "src/com/crdroid/ltpo/oplus/LTPOConfig.java",
        "tests/src/**/*.java",
    ],
    main_class: "com.crdroid.ltpo.oplus.LTPOConfigTest",
}
