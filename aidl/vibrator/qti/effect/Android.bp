// The single consolidated effect-stream owner for the QTI vibrator service.
// It carries its own built-in waveform table (VibrationEffectConfig.h, included
// by path from effect.cpp so no device-set include dir can leave it unresolved)
// and prefers /odm/etc/vibrator/vibrator_effect.json when the device ships one.
// A device tree must not build a second get_effect_stream() provider.
cc_library_shared {
    name: "liboplusvibratoreffect",
    vendor: true,
    srcs: [
        "effect.cpp",
        "VibrationEffectLoader.cpp"
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libjsoncpp",
        "libutils",
    ],
}
