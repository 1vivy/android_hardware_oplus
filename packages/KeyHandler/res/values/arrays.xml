    <!-- Plus Key. A programmable shortcut button wants button actions, not the
         alert slider's ringer positions: reusing those left a dedicated hardware
         key able to do nothing but pick a ringer mode. The values are disjoint
         from the slider's so the two mappings cannot be confused for one
         another. The assistant row is dropped at runtime when no assistant is
         installed - see ButtonSettingsFragment. -->
    <string-array name="plus_key_action_entries" translatable="false">
        <item>@string/plus_key_action_none</item>
        <item>@string/plus_key_action_assistant</item>
