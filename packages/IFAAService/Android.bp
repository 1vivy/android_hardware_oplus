android_app {
    name: "IFAAService",
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
        "src/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["src"],
    },

    static_libs: [
        "vendor.oplus.hardware.biometrics.fingerprintpay-V1-java",
    ],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
}

java_test_host {
    name: "IFAAServiceIdentityTest",
    srcs: [
        "src/**/IfaaProjectIdentity.java",
        "tests/src/**/*.java",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
